minimumLimaVersion: 2.0.0
base:
- template:_images/ubuntu-26.04

vmType: vz
mountType: virtiofs
cpus: __CPUS__
memory: __MEMORY__
disk: __DISK__

# Enable credential sharing only for VMs explicitly created with `--agent-access`.
ssh:
  forwardAgent: __FORWARD_AGENT__

mounts:
__MOUNTS__

containerd:
  system: false
  user: false

# Disable automatic port forwarding to prevent collisions between identical ports in multiple
# VMs. Publish ports explicitly with `wtx forward`.
portForwards:
- guestIP: "0.0.0.0"
  guestPortRange: [1, 65535]
  proto: any
  ignore: true

provision:
- mode: system
  script: |
    #!/bin/bash
    set -eux -o pipefail
    if docker version 2>/dev/null | grep -Eq 'Version:[[:space:]]+29\.7\.2'; then exit 0; fi
    mkdir -p /etc/docker
    cat >/etc/docker/daemon.json <<'DAEMON'
    {
      "registry-mirrors": ["http://host.lima.internal:__MIRROR_PORT__"],
      "insecure-registries": ["host.lima.internal:__MIRROR_PORT__"]
    }
    DAEMON
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y ca-certificates curl
    install -m 0755 -d /etc/apt/keyrings
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
    chmod a+r /etc/apt/keyrings/docker.asc
    cat >/etc/apt/sources.list.d/docker.sources <<'DOCKER_REPO'
    Types: deb
    URIs: https://download.docker.com/linux/ubuntu
    Suites: resolute
    Components: stable
    Architectures: arm64
    Signed-By: /etc/apt/keyrings/docker.asc
    DOCKER_REPO
    apt-get update
    apt-get install -y \
      docker-ce='5:29.7.2-1~ubuntu.26.04~resolute' \
      docker-ce-cli='5:29.7.2-1~ubuntu.26.04~resolute' \
      containerd.io='2.3.3-1~ubuntu.26.04~resolute' \
      docker-buildx-plugin='0.36.1-1~ubuntu.26.04~resolute' \
      docker-compose-plugin='5.4.0-1~ubuntu.26.04~resolute'
    apt-mark hold docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
    usermod -aG docker {{.User}}
    git config --system --add safe.directory '*'

probes:
- script: |
    #!/bin/bash
    set -eux -o pipefail
    if ! timeout 120s bash -c "until command -v docker >/dev/null; do sleep 3; done"; then
      echo >&2 "provision incomplete"
      exit 1
    fi
  hint: See /var/log/cloud-init-output.log in the guest
